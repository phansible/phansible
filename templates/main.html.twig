<!DOCTYPE html>
<html>
<head>
    {% include "partials/head.html.twig" %}
</head>
<body id="phansible">
<div class="ui fixed transparent inverted main menu">
    <div class="container">
        <a href="{{ path('phansible_default') }}">
            <div class="title item">Home</div>
        </a>
        <a href="{{ path('phansible_about') }}">
            <div class="title item">About</div>
        </a>
        <div class="ui dropdown item">
            Documentation <i class="icon dropdown"></i>
            <div class="menu">
                <a class="item" href="{{ path('phansible_docs', {'doc': 'usage'}) }}">Usage Instructions</a>
                <a class="item" href="{{ path('phansible_docs', {'doc': 'customize'}) }}">Customizing your Bundle</a>
                <a class="item" href="{{ path('phansible_docs', {'doc': 'vagrant'}) }}">Vagrant crash-course</a>
                <a class="item" href="{{ path('phansible_docs', {'doc': 'contributing'}) }}">Contributing</a>
            </div>
        </div>
        <a href="https://github.com/phansible/phansible">
            <div class="title item"><i class="github icon"></i> GitHub</div>
        </a>
    </div>
</div>

<header>
    <div class="container">
        <div class="introduction">
            <img class="logo img-responsive" src="/assets/images/phansible-logo-white.png" alt="phansible"
                 title="phansible">
            <p>Phansible provides an easy-to-use interface that helps you generate Ansible provisionings for PHP-based
                projects.</p>
        </div>
    </div>
</header>

<div class="main container">
    {% block content %}{% endblock %}
</div>

{% include "partials/footer.html.twig" %}

{% include "partials/javascripts.html.twig" %}

</body>
</html>
